<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName>vstodo</OutputName>
    <DefineConstants>Version=$(VSTodoVersion);BinaryPath=$(VSTodoBinaryPath);InstallerBinaryPath=$(VSTodoInstallerBinaryPath)</DefineConstants>
  </PropertyGroup>
</Project>
